{
  "manifest_version": 3,
  "name": "Virtual GEO",
  "version": "2.2",
  "description": "Виртуальная геолокация — задайте свои координаты для всех сайтов",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Virtual GEO"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "homepage_url": "https:/vitalibkru.github.io/virtual-geo/",
  "minimum_chrome_version": "110"
}